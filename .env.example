# LooksFine Environment Configuration

# Database Connection (PostgreSQL)
# Example: postgresql://username:password@localhost:5432/looksfine?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/looksfine?schema=public"

# Authentication / Session Secret
# Generate a secure random string for production (e.g. openssl rand -base64 32)
JWT_SECRET="looksfine_dev_secret_key_change_in_production_2026"
SESSION_COOKIE_NAME="looksfine_session"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Future AI & ML Microservice Configuration (Placeholders)
ML_SERVICE_URL="http://localhost:8000"
GEMINI_API_KEY=""
