// LooksFine Production PostgreSQL Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FOOD_SAFETY_INSPECTOR
  INSPECTION_MANAGER
  ESTABLISHMENT_MANAGER
  FOOD_SAFETY_ADMIN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  SUBMITTED
  REVIEWED
  CORRECTIVE_ACTION_REQUIRED
  RESOLVED
}

enum ViolationCategory {
  IMPROPER_STORAGE
  TEMPERATURE_CONTROL
  SANITATION
  PESTS
  CROSS_CONTAMINATION
  EXPIRED_FOOD
  UNSAFE_HANDLING
  FACILITY_HYGIENE
}

enum Severity {
  MINOR
  MAJOR
  CRITICAL
}

enum CorrectiveActionStatus {
  REQUIRED
  SUBMITTED
  ACCEPTED
  REJECTED
  REINSPECTION_REQUIRED
  CLOSED
}

model User {
  id                  String             @id @default(uuid())
  name                String
  email               String             @unique
  password            String
  role                Role               @default(FOOD_SAFETY_INSPECTOR)
  region              String?
  assignedInspections Inspection[]       @relation("AssignedInspector")
  reviewedActions     CorrectiveAction[] @relation("ActionReviewer")
  notifications       Notification[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model Establishment {
  id                 String             @id @default(uuid())
  name               String
  type               String
  address            String
  city               String             @default("San Francisco")
  state              String             @default("CA")
  latitude           Float
  longitude          Float
  operatingStatus    String             @default("ACTIVE")
  assignedRegion     String
  riskLevel          RiskLevel          @default(MEDIUM)
  currentRiskScore   Int                @default(50)
  lastInspectionDate DateTime?
  nextInspectionDate DateTime?
  inspections        Inspection[]
  violations         Violation[]
  correctiveActions  CorrectiveAction[]
  riskAssessments    RiskAssessment[]
  riskHistory        RiskHistory[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([assignedRegion])
  @@index([riskLevel])
  @@index([currentRiskScore])
}

model Inspection {
  id                String             @id @default(uuid())
  establishmentId   String
  establishment     Establishment      @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  inspectorId       String
  inspector         User               @relation("AssignedInspector", fields: [inspectorId], references: [id])
  scheduledDate     DateTime
  startedAt         DateTime?
  submittedAt       DateTime?
  status            InspectionStatus   @default(SCHEDULED)
  notes             String?
  overallResult     String?
  violations        Violation[]
  correctiveActions CorrectiveAction[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([establishmentId])
  @@index([inspectorId])
  @@index([status])
  @@index([scheduledDate])
  @@index([createdAt])
}

model Violation {
  id                       String             @id @default(uuid())
  inspectionId             String
  inspection               Inspection         @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  establishmentId          String
  establishment            Establishment      @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  category                 ViolationCategory
  severity                 Severity
  description              String
  evidenceUrl              String?
  correctiveActionRequired Boolean            @default(true)
  resolutionStatus         String             @default("OPEN")
  isRecurring              Boolean            @default(false)
  detectedAt               DateTime           @default(now())
  resolvedAt               DateTime?
  correctiveActions        CorrectiveAction[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([inspectionId])
  @@index([establishmentId])
  @@index([category])
  @@index([severity])
  @@index([createdAt])
}

model CorrectiveAction {
  id                String                 @id @default(uuid())
  violationId       String
  violation         Violation              @relation(fields: [violationId], references: [id], onDelete: Cascade)
  establishmentId   String
  establishment     Establishment          @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  inspectionId      String?
  inspection        Inspection?            @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  description       String
  submittedEvidence String?
  status            CorrectiveActionStatus @default(REQUIRED)
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewerId        String?
  reviewer          User?                  @relation("ActionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNotes       String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([violationId])
  @@index([establishmentId])
  @@index([status])
  @@index([createdAt])
}

model RiskAssessment {
  id              String        @id @default(uuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  riskScore       Int
  riskLevel       RiskLevel
  assessmentType  String        @default("INITIAL_BASELINE")
  explanation     String?
  assessedAt      DateTime      @default(now())

  @@index([establishmentId])
  @@index([riskLevel])
  @@index([assessedAt])
}

model RiskHistory {
  id              String        @id @default(uuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  riskScore       Int
  riskLevel       RiskLevel
  reason          String
  createdAt       DateTime      @default(now())

  @@index([establishmentId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}
