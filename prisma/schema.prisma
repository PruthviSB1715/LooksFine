// LooksFine Prisma Schema
// Compatible with local zero-config SQLite and PostgreSQL via DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String             @id @default(uuid())
  name                String
  email               String             @unique
  password            String
  role                String             @default("FOOD_SAFETY_INSPECTOR") // FOOD_SAFETY_INSPECTOR, INSPECTION_MANAGER, ESTABLISHMENT_MANAGER, FOOD_SAFETY_ADMIN
  region              String?
  assignedInspections Inspection[]       @relation("AssignedInspector")
  reviewedActions     CorrectiveAction[] @relation("ActionReviewer")
  notifications       Notification[]
  copilotConversations CopilotConversation[]
  uploadedEvidences   Evidence[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model Establishment {
  id                 String             @id @default(uuid())
  name               String
  type               String             // Restaurant, Hotel, Bakery, Cafe, School/College Cafeteria, Hospital Kitchen, Food Truck
  address            String
  city               String             @default("Solapur")
  state              String             @default("Maharashtra")
  latitude           Float
  longitude          Float
  operatingStatus    String             @default("ACTIVE") // ACTIVE, SUSPENDED, CLOSED, UNDER_REVIEW
  assignedRegion     String             // Mission District, Marina, SoMa, North Beach, Financial District, etc.
  riskLevel          String             @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  currentRiskScore   Int                @default(50) // 0-100 score
  lastInspectionDate DateTime?
  nextInspectionDate DateTime?
  inspections        Inspection[]
  violations         Violation[]
  correctiveActions  CorrectiveAction[]
  riskAssessments    RiskAssessment[]
  riskHistory        RiskHistory[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([assignedRegion])
  @@index([riskLevel])
  @@index([currentRiskScore])
}

model Inspection {
  id                String             @id @default(uuid())
  establishmentId   String
  establishment     Establishment      @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  inspectorId       String
  inspector         User               @relation("AssignedInspector", fields: [inspectorId], references: [id])
  scheduledDate     DateTime
  startedAt         DateTime?
  submittedAt       DateTime?
  status            String             @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, SUBMITTED, REVIEWED, CORRECTIVE_ACTION_REQUIRED, RESOLVED
  notes             String?
  overallResult     String?
  violations        Violation[]
  correctiveActions CorrectiveAction[]
  evidences         Evidence[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([establishmentId])
  @@index([inspectorId])
  @@index([status])
  @@index([scheduledDate])
  @@index([createdAt])
}

model Violation {
  id                       String             @id @default(uuid())
  inspectionId             String
  inspection               Inspection         @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  establishmentId          String
  establishment            Establishment      @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  category                 String             // IMPROPER_STORAGE, TEMPERATURE_CONTROL, SANITATION, PESTS, CROSS_CONTAMINATION, EXPIRED_FOOD, UNSAFE_HANDLING, FACILITY_HYGIENE
  severity                 String             // MINOR, MAJOR, CRITICAL
  description              String
  evidenceUrl              String?
  correctiveActionRequired Boolean            @default(true)
  resolutionStatus         String             @default("OPEN")
  isRecurring              Boolean            @default(false)
  detectedAt               DateTime           @default(now())
  resolvedAt               DateTime?
  correctiveActions        CorrectiveAction[]
  evidence                 Evidence?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([inspectionId])
  @@index([establishmentId])
  @@index([category])
  @@index([severity])
  @@index([createdAt])
}

model CorrectiveAction {
  id                String    @id @default(uuid())
  violationId       String
  violation         Violation @relation(fields: [violationId], references: [id], onDelete: Cascade)
  establishmentId   String
  establishment     Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  inspectionId      String?
  inspection        Inspection? @relation(fields: [inspectionId], references: [id], onDelete: SetNull)
  description       String
  submittedEvidence String?
  status            String    @default("REQUIRED") // REQUIRED, SUBMITTED, ACCEPTED, REJECTED, REINSPECTION_REQUIRED, CLOSED
  submittedAt       DateTime?
  reviewedAt        DateTime?
  reviewerId        String?
  reviewer          User?     @relation("ActionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNotes       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([violationId])
  @@index([establishmentId])
  @@index([status])
  @@index([createdAt])
}

model RiskAssessment {
  id              String        @id @default(uuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  riskScore       Int
  riskLevel       String        // LOW, MEDIUM, HIGH, CRITICAL
  assessmentType  String        @default("INITIAL_BASELINE") // ML_PREDICTION, INITIAL_BASELINE, POST_INSPECTION
  explanation     String?
  assessedAt      DateTime      @default(now())

  @@index([establishmentId])
  @@index([riskLevel])
  @@index([assessedAt])
}

model RiskHistory {
  id              String        @id @default(uuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  riskScore       Int
  riskLevel       String        // LOW, MEDIUM, HIGH, CRITICAL
  reason          String
  createdAt       DateTime      @default(now())

  @@index([establishmentId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([read])
  @@index([createdAt])
}

model CopilotConversation {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  messages  CopilotMessage[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([createdAt])
}

model CopilotMessage {
  id             String              @id @default(uuid())
  conversationId String
  conversation   CopilotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String              // user, assistant, system
  content        String
  intent         String?
  sources        String?             // JSON stringified sources
  createdAt      DateTime            @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model Evidence {
  id                     String      @id @default(uuid())
  inspectionId           String
  inspection             Inspection  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  uploadedById           String?
  uploadedBy             User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  fileName               String
  fileType               String
  fileSize               Int
  storagePath            String
  scanStatus             String      @default("UPLOADED") // UPLOADED, ANALYZING, ANALYZED, REVIEW_REQUIRED, ACCEPTED, REJECTED, FAILED
  aiProvider             String?     @default("gemini-vision")
  aiModel                String?     @default("gemini-2.5-flash")
  candidateCategory      String?     // IMPROPER_STORAGE, CROSS_CONTAMINATION, FACILITY_HYGIENE, PEST_ACTIVITY, UNSAFE_HANDLING
  candidateConfidence    Float?
  candidateTitle         String?
  candidateDescription    String?
  candidateReasoning      String?
  severityRecommendation String?     // MINOR, MAJOR, CRITICAL
  boundingBox            String?     // JSON serialized normalized box
  reviewStatus           String      @default("PENDING") // PENDING, ACCEPTED, REJECTED
  reviewedAt             DateTime?
  reviewedById           String?
  violationId            String?     @unique
  violation              Violation?  @relation(fields: [violationId], references: [id], onDelete: SetNull)
  uploadedAt             DateTime    @default(now())
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@index([inspectionId])
  @@index([scanStatus])
  @@index([reviewStatus])
  @@index([createdAt])
}
